<view class="container">
  <view wx:if="{{!isVerified}}" class="verify-section">
    <text class="title">管理员验证</text>
    <input 
      type="password" 
      placeholder="请输入管理密码"
      password="{{true}}"
      value="{{password}}"
      bindinput="handlePasswordInput"
    />
    <button type="primary" bindtap="handleVerify">验证</button>
  </view>

  <view wx:else class="settings-section">
    <view class="setting-item">
      <text class="label">抓取间隔（分钟）</text>
      <input 
        type="number" 
        value="{{settings.crawlInterval}}"
        data-field="crawlInterval"
        bindinput="handleSettingChange"
      />
    </view>

    <view class="setting-item">
      <text class="label">每个源抓取数量</text>
      <input 
        type="number" 
        value="{{settings.preArticlesPerSource}}"
        data-field="preArticlesPerSource"
        bindinput="handleSettingChange"
      />
    </view>

    <view class="setting-item">
      <text class="label">自动抓取</text>
      <switch 
        checked="{{settings.autoCrawl}}"
        data-field="autoCrawl"
        bindchange="handleSettingChange"
      />
    </view>

    <view class="actions">
      <button type="primary" bindtap="handleSave">保存设置</button>
      <button type="default" bindtap="handleManualCrawl">手动抓取</button>
    </view>
  </view>
</view> 