.container {
  padding: 30rpx;
}

.verify-section {
  text-align: center;
  padding: 40rpx;
}

.verify-section .title {
  font-size: 36rpx;
  margin-bottom: 30rpx;
}

.verify-section input {
  border: 1px solid #ddd;
  padding: 20rpx;
  margin-bottom: 30rpx;
  border-radius: 8rpx;
}

.settings-section {
  background: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
}

.setting-item {
  margin-bottom: 30rpx;
}

.setting-item .label {
  display: block;
  margin-bottom: 10rpx;
  color: #333;
}

.setting-item input {
  border: 1px solid #ddd;
  padding: 16rpx;
  border-radius: 8rpx;
}

.actions {
  margin-top: 40rpx;
  display: flex;
  gap: 20rpx;
}

.actions button {
  flex: 1;
}

.verify-btn {
  width: 80%;
  margin: 20rpx auto;
}

.error-tip {
  color: #ff4d4f;
  font-size: 28rpx;
  margin: 20rpx 0;
  display: block;
} 