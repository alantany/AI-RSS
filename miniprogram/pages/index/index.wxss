.container {
  padding: 16rpx;
  background: #f5f5f5;
}

.article-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.article-category {
  font-size: 24rpx;
  color: #1890ff;
  background: #e6f7ff;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  display: inline-block;
  margin-bottom: 8rpx;
}

.article-header {
  margin-bottom: 8rpx;
}

.article-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  line-height: 1.4;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.article-source {
  font-size: 24rpx;
  color: #999;
}

.article-summary {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
  margin: 12rpx 0;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.article-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1px solid #f0f0f0;
}

.article-date {
  font-size: 24rpx;
  color: #999;
}

.article-actions {
  display: flex;
  gap: 16rpx;
}

.action-item {
  font-size: 24rpx;
  color: #666;
}

.loading {
  text-align: center;
  padding: 16rpx;
}

.loading-text {
  color: #999;
  font-size: 22rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx;
  background: #fff;
  margin-bottom: 12rpx;
  border-radius: 12rpx;
}

.title {
  font-size: 30rpx;
  font-weight: 500;
}

.settings-btn {
  margin: 0 !important;
  padding: 0 16rpx !important;
  font-size: 24rpx !important;
  line-height: 2 !important;
}

.settings-btn .icon {
  width: 100%;
  height: 100%;
}

.title-section {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.article-count {
  font-size: 22rpx;
  color: #999;
}
  