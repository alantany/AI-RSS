<view class="container">
  <view class="header">
    <text class="title">AI 新闻聚合</text>
    <text class="count">共 {{totalCount}} 篇</text>
  </view>

  <view class="article-card" wx:for="{{articles}}" wx:key="_id">
    <view 
      class="article-header" 
      bindtap="handleArticleClick" 
      data-id="{{item._id}}"
      hover-class="hover"
    >
      <text class="article-title">{{item.translatedTitle || item.title}}</text>
      <text class="article-source">{{item.source}}</text>
    </view>
    
    <view class="article-summary">
      {{item.translatedSummary || item.summary}}
    </view>
    
    <view class="article-footer">
      <text class="article-date">{{item.publishDate}}</text>
    </view>
  </view>

  <view class="loading" wx:if="{{loading}}">加载中...</view>
  <!-- <view class="no-more" wx:if="{{articles.length > 0}}">没有更多文章了</view> -->
</view> 