.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.article-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.article-header {
  padding: 30rpx;
}

.article-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  margin-bottom: 30rpx;
}

.article-meta {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.article-content {
  font-size: 34rpx;
  line-height: 1.8;
  color: #333;
  padding: 30rpx;
}

.article-content h3 {
  font-size: 40rpx;
  font-weight: bold;
  color: #222;
  margin: 40rpx 0;
  padding-left: 20rpx;
  border-left: 8rpx solid #07c160;
}

.loading {
  text-align: center;
  padding: 40rpx;
  color: #999;
}

.section-title {
  font-size: 40rpx !important;
  font-weight: bold !important;
  color: #222 !important;
  margin: 40rpx 0 !important;
  padding-left: 20rpx !important;
  border-left: 8rpx solid #07c160 !important;
  line-height: 1.4 !important;
}

.article-abstract {
  font-size: 32rpx;
  line-height: 1.6;
  color: #666;
  background: #f8f9fa;
  padding: 30rpx;
  margin: 20rpx 0;
  border-radius: 8rpx;
}

.article-content p {
  margin-bottom: 20rpx;
  line-height: 1.8;
} 